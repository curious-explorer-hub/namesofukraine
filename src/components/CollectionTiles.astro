---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Portrait from './Portrait.astro';
import { mostLinked, type Person } from '../lib/people';
import { t, type Lang } from '../i18n';
import collections from '../content/collections.json';

interface Props {
  people: Person[];
  lang: Lang;
}

const { people, lang } = Astro.props;
// Cards like the era ribbon's (same styles and sliding highlight), each with a picture of its theme
// (credits: src/content/collections.json, Credits page).
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/collections/*.jpg', { eager: true });
const background = async (file: string) => {
  const img = images[`../assets/collections/${file}`]?.default;
  return img ? `--era-bg: url(${(await getImage({ src: img, width: 600, height: 460, fit: 'cover', format: 'webp', quality: 65 })).src})` : undefined;
};
const cards = (
  await Promise.all(
    collections.collections.map(async (c) => {
      const members = people.filter((p) => p.data.collections.includes(c.id));
      return { ...c, bg: await background(c.image.file), members, faces: mostLinked(members, people, 3) };
    }),
  )
).filter((c) => c.members.length > 0);
---

<nav class="ribbon" aria-labelledby="collections-title">
  <h2 id="collections-title" class="visually-hidden">{t('explore.tab_collections', lang)}</h2>
  <ol class="ribbon-bands ribbon-bands-collections">
    {
      cards.map((c, i) => (
        <li>
          <button
            type="button"
            class="era"
            data-collection={c.id}
            style={[c.bg, `--i: ${i}`].filter(Boolean).join('; ')}
            title={c.image.caption[lang]}
            aria-pressed="false"
          >
            <span class="era-tally" aria-hidden="true">
              <span class="era-count" style={`--count: ${c.members.length}`}><span>{c.members.length}</span></span>
            </span>
            <span class="era-faces" aria-hidden="true">
              {c.faces.map((p) => (
                <Portrait person={p} class="era-face" widths={[56, 112]} sizes="2.75rem" tag="span" />
              ))}
            </span>
            <span class="era-name">{c.label[lang]}</span>
            <span class="visually-hidden">{t('collections.count', lang, { n: c.members.length })}</span>
          </button>
        </li>
      ))
    }
    <li class="ribbon-indicator" aria-hidden="true"></li>
  </ol>
  {/* Why the selected collection exists: one shows while its card is pressed (src/scripts/filter.ts) */}
  <div class="collection-notes" aria-live="polite">
    {cards.map((c) => <p class="collection-note" data-collection-note={c.id} hidden>{c.description[lang]}</p>)}
  </div>
</nav>
