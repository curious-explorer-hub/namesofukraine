---
import { regions, project, WIDTH, HEIGHT } from '../lib/map';
import { CONTINENTS, continentOf, frame } from '../lib/world';
import { personUrl, regionLabel, type Person } from '../lib/people';
import { t, type Key, type Lang } from '../i18n';

interface Props {
  people: Person[];
  lang: Lang;
}

const { people, lang } = Astro.props;
const MAX_NAMES = 4;

// How many people were born in each region (also those without exact coordinates).
const totals = new Map<string, number>();
for (const p of people) totals.set(p.data.birthplace.region, (totals.get(p.data.birthplace.region) ?? 0) + 1);
const most = Math.max(1, ...[...totals].filter(([id]) => id !== 'abroad' && id !== 'unknown').map(([, n]) => n));

// One dot per birthplace inside Ukraine; people born in the same place share a numbered dot. A place
// that is one version among several (birthplace.version) gets its own hollow ring.
const places = new Map<string, Person[]>();
for (const p of people) {
  const { lat, lon, region, version } = p.data.birthplace;
  if (lat === undefined || lon === undefined || region === 'abroad' || (region === 'unknown' && !version)) continue;
  const key = `${lat.toFixed(2)},${lon.toFixed(2)}${version ? `,${p.slug}` : ''}`;
  places.set(key, [...(places.get(key) ?? []), p]);
}
const dots = [...places.values()]
  .map((group) => {
    const [x, y] = project(group[0].data.birthplace.lon!, group[0].data.birthplace.lat!);
    const names = group.slice(0, MAX_NAMES).map((p) => p.data.name);
    if (group.length > MAX_NAMES) names.push(t('map.more', lang, { n: group.length - MAX_NAMES }));
    const version = group[0].data.birthplace.version;
    return { x, y, group, version, names: version ? t('map.version_tip', lang, { name: names[0] }) : names.join(', ') };
  })
  .sort((a, b) => b.group.length - a.group.length); // big dots first, so single ones stay on top

// Side list: regions by head count, then people born abroad or in an unknown place.
const list = [...totals]
  .sort(([a, n], [b, m]) => Number(a === 'abroad' || a === 'unknown') - Number(b === 'abroad' || b === 'unknown') || m - n)
  // Short names in the list ("Полтавська", not "Полтавська область"); the map's labels keep the full name.
  .map(([id, n]) => ({ id, n, label: regionLabel(id, lang).replace(/ (область|Oblast)$/, '') }));
const level = (n: number) => (n ? Math.ceil((n / most) * 4) : 0);

// Born outside Ukraine: a small card per continent that has someone (src/lib/world.ts), same dots.
const dotsIn = (group: Person[][], proj: (lon: number, lat: number) => [number, number], width: number) =>
  group
    .map((g) => {
      const [x, y] = proj(g[0].data.birthplace.lon!, g[0].data.birthplace.lat!);
      return { x, y, group: g, names: g.map((p) => p.data.name).join(', '), delay: Math.round((x / width) * 600) };
    })
    .sort((a, b) => b.group.length - a.group.length);
const abroad = people.filter((p) => p.data.birthplace.region === 'abroad' && p.data.birthplace.lat !== undefined && p.data.birthplace.lon !== undefined);
const cards = CONTINENTS.map(({ id }) => {
  const here = abroad.filter((p) => continentOf(p.data.birthplace.lon!, p.data.birthplace.lat!) === id);
  if (!here.length) return null;
  const f = frame(id);
  const byPlace = new Map<string, Person[]>();
  for (const p of here) {
    const key = `${p.data.birthplace.lat!.toFixed(2)},${p.data.birthplace.lon!.toFixed(2)}`;
    byPlace.set(key, [...(byPlace.get(key) ?? []), p]);
  }
  return { ...f, name: t(`map.continent.${id}` as Key, lang), people: here, dots: dotsIn([...byPlace.values()], f.project, f.width) };
}).filter((c) => c !== null);
---

<section class="map" data-map data-most={most} data-label={t('map.region_label', lang, { region: '{region}', n: '{n}' })} data-empty={t('map.region_empty', lang, { region: '{region}' })} aria-labelledby="map-title">
  <h2 id="map-title" class="visually-hidden">{t('map.title', lang)}</h2>
  <p class="map-hint">{t('map.hint', lang)}</p>
  <div class="map-body">
    <div class="map-canvas">
      {/* An image without JavaScript; the script turns the regions into buttons that filter by region. */}
      <svg class="map-svg" viewBox={`0 0 ${WIDTH} ${HEIGHT}`} role="img" aria-label={t('map.label', lang)}>
        <g class="map-regions">
          {regions.map((r) => (
            <path
              class="map-region"
              d={r.d}
              fill-rule="evenodd"
              data-region={r.id}
              data-name={regionLabel(r.id, lang)}
              data-level={level(totals.get(r.id) ?? 0)}
            />
          ))}
        </g>
        <g class="map-dots" aria-hidden="true">
          {dots.map((d) => (
            <g
              class:list={['map-dot', { 'map-dot-many': d.group.length > 1, 'map-dot-version': d.version }]}
              data-group={d.group.length === 1 ? d.group[0].data.group : undefined}
              data-slugs={d.group.map((p) => p.slug).join(' ')}
              data-region={d.group[0].data.birthplace.region}
              data-names={d.names}
              data-href={d.group.length === 1 ? personUrl(d.group[0]) : undefined}
              style={`--d: ${Math.round((d.x / WIDTH) * 900)}ms`}>
              <circle cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r={d.group.length > 1 ? 6 + Math.sqrt(d.group.length) * 2.5 : 5} />
              {d.group.length > 1 && (
                <text x={d.x.toFixed(1)} y={d.y.toFixed(1)} dy="0.35em">{d.group.length}</text>
              )}
            </g>
          ))}
        </g>
      </svg>
      {
        cards.length > 0 && (
          <div class="map-world">
            <h3 class="map-side-title">{t('map.abroad_title', lang)}</h3>
            <ul class="map-world-cards" role="list">
              {cards.map((c) => (
                <li class="map-world-card" data-slugs={c.people.map((p) => p.slug).join(' ')}>
                  <svg class="map-svg map-svg-world" viewBox={`0 0 ${c.width} ${c.height}`} role="img" aria-label={`${c.name}: ${c.people.map((p) => p.data.name).join(', ')}`}>
                    <path class="map-land" d={c.land} />
                    {c.ukraine && <path class="map-home" d={c.ukraine} />}
                    <g class="map-dots" aria-hidden="true">
                      {c.dots.map((d) => (
                        <g
                          class:list={['map-dot', { 'map-dot-many': d.group.length > 1 }]}
                          data-group={d.group.length === 1 ? d.group[0].data.group : undefined}
                          data-slugs={d.group.map((p) => p.slug).join(' ')}
                          data-region="abroad"
                          data-names={d.names}
                          data-href={d.group.length === 1 ? personUrl(d.group[0]) : undefined}
                          style={`--d: ${d.delay}ms`}>
                          <circle cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r={d.group.length > 1 ? 7 + Math.sqrt(d.group.length) * 2.5 : 6} />
                          {d.group.length > 1 && <text x={d.x.toFixed(1)} y={d.y.toFixed(1)} dy="0.35em">{d.group.length}</text>}
                        </g>
                      ))}
                    </g>
                  </svg>
                  <p class="map-world-name">{c.name} <span class="map-world-count">{c.people.length}</span></p>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {dots.some((d) => d.version) && <p class="map-legend"><span class="map-legend-ring" aria-hidden="true"></span>{t('map.version_legend', lang)}</p>}
      <div class="map-tip" hidden></div>
    </div>
    <div class="map-side">
      <h3 class="map-side-title">{t('map.places', lang)}</h3>
      <ul class="map-list" role="list">
        {list.map((r) => (
          <li>
            <button type="button" class="map-pick" data-region={r.id} aria-pressed="false">
              <span class="map-pick-name">{r.label}</span>
              <span class="map-pick-count" data-total={r.n}>{r.n}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <p class="map-credit">{t('map.credit', lang)}</p>
</section>
