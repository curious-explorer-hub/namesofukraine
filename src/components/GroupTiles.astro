---
import Portrait from './Portrait.astro';
import { groups, groupUrl, type Person } from '../lib/people';
import { t, type Lang } from '../i18n';

interface Props {
  people: Person[];
  lang: Lang;
}

const { people, lang } = Astro.props;
const FACES = 3;
// The faces on a tile: the people other profiles link to most (a stand-in for prominence), then the earliest born.
const links = new Map<string, number>();
for (const p of people) for (const slug of p.data.related) links.set(slug, (links.get(slug) ?? 0) + 1);
const tiles = groups
  .map((g) => {
    const members = people.filter((p) => p.data.group === g.id);
    const faces = members
      .filter((p) => p.data.image)
      .sort((a, b) => (links.get(b.slug) ?? 0) - (links.get(a.slug) ?? 0))
      .slice(0, FACES);
    return { ...g, members, faces };
  })
  .filter((g) => g.members.length > 0);
---

<section class="tiles" aria-labelledby="tiles-title">
  <h2 id="tiles-title" class="section-title">{t('home.groups', lang)}</h2>
  <ul class="tiles-grid" role="list">
    {
      tiles.map((g) => (
        <li class="tile-item" data-group={g.id}>
          {/* In "unread only" mode the filter script updates the count and link to unread people only. */}
          <a
            class="tile"
            href={groupUrl(g.id, lang)}
            data-label={t('home.group_all', lang, { n: '{n}' })}
            data-total={g.members.length}>
            <span class="tile-faces" aria-hidden="true">
              {g.faces.map((p) => (
                <Portrait person={p} class="tile-face" widths={[96, 160]} sizes="5rem" />
              ))}
            </span>
            <span class="tile-name">{g.label[lang]}</span>
            <span class="tile-count">{t('home.group_all', lang, { n: g.members.length })}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
