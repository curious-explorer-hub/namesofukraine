---
import Portrait from './Portrait.astro';
import { groups, groupUrl, mostLinked, type Person } from '../lib/people';
import { t, type Lang } from '../i18n';
import { fieldIcons, iconSpots } from '../lib/field-icons';

interface Props {
  people: Person[];
  lang: Lang;
}

const { people, lang } = Astro.props;
// The faces on a tile: the most-linked people of the group, then the earliest born.
const tiles = groups
  .map((g) => {
    const members = people.filter((p) => p.data.group === g.id);
    return { ...g, members, faces: mostLinked(members, people, 3) };
  })
  .filter((g) => g.members.length > 0);
---

<section class="tiles" aria-labelledby="tiles-title">
  <h2 id="tiles-title" class="visually-hidden">{t('home.groups', lang)}</h2>
  <ul class="tiles-grid" role="list">
    {
      tiles.map((g) => (
        <li class="tile-item" data-group={g.id}>
          {/* In "unread only" mode the filter script updates the count and link to unread people only. */}
          <a
            class="tile"
            href={groupUrl(g.id, lang)}
            data-total={g.members.length}>
            {/* Drawings of the field (a ball and a dumbbell for sport, an open book for literature) */}
            <svg class="tile-art" viewBox="0 0 300 200" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
              {iconSpots.map((spot, i) => (
                <g
                  transform={`translate(${spot.x} ${spot.y}) rotate(${spot.r} ${12 * spot.s} ${12 * spot.s}) scale(${spot.s})`}
                  set:html={fieldIcons[g.id]?.[i % 3] ?? ''}
                />
              ))}
            </svg>
            <span class="tile-faces" aria-hidden="true">
              {g.faces.map((p) => (
                <Portrait person={p} class="tile-face" widths={[96, 160]} sizes="5rem" />
              ))}
            </span>
            <span class="tile-name">{g.label[lang]}</span>
            <span class="tile-count">{g.members.length}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
