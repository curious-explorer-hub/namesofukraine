---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { eras, mostLinked, type Person } from '../lib/people';
import Portrait from './Portrait.astro';
import { t, type Lang } from '../i18n';

interface Props {
  people: Person[];
  lang: Lang;
}

const { people, lang } = Astro.props;
// A picture of each era sits behind its band, in colour (credits: src/content/eras.json, About page).
// Cropped to the card shape (about 290×225 CSS px on desktop, at 2× density), centred like the CSS `cover`.
const eraImages = import.meta.glob<{ default: ImageMetadata }>('../assets/eras/*.jpg', { eager: true });
const background = async (file: string) => {
  const img = eraImages[`../assets/eras/${file}`]?.default;
  return img ? `--era-bg: url(${(await getImage({ src: img, width: 600, height: 460, fit: 'cover', format: 'webp', quality: 65 })).src})` : undefined;
};
const bands = await Promise.all(eras.map(async (era) => {
  const members = people
    .filter((p) => p.data.era === era.id)
    .sort((a, b) => a.data.born.getTime() - b.data.born.getTime());
  // A few faces of the era: its most-linked people, then the earliest born.
  return { ...era, bg: await background(era.image.file), people: members, faces: mostLinked(members, people, 3) };
}));
---

<nav class="ribbon" aria-labelledby="ribbon-title">
  <h2 id="ribbon-title" class="visually-hidden">{t('home.eras', lang)}</h2>
  <ol class="ribbon-bands">
    {
      bands.map((band, i) => (
        <li>
          <button
            type="button"
            class="era"
            data-era={band.id}
            style={[band.bg, `--i: ${i}`].filter(Boolean).join('; ')}
            title={band.image.caption[lang]}
            aria-pressed="false"
            disabled={band.people.length === 0}
          >
            {/* How many people this era has, in the top right corner */}
            <span class="era-tally" aria-hidden="true">
              {band.people.length === 0 ? (
                <span class="era-empty">{t('home.era_empty', lang)}</span>
              ) : (
                <>
                  {/* Counts up from 0 on load (CSS); the plain number is the fallback */}
                  <span class="era-count" style={`--count: ${band.people.length}`}><span>{band.people.length}</span></span>
                </>
              )}
            </span>
            {band.faces.length > 0 && (
              <span class="era-faces" aria-hidden="true">
                {band.faces.map((p) => (
                  <Portrait person={p} class="era-face" widths={[56, 112]} sizes="2.75rem" tag="span" />
                ))}
              </span>
            )}
            <span class="era-name">{band.label[lang]}</span>
            <span class="era-span">{band.span[lang]}</span>
            <span class="visually-hidden">{t('home.era_count', lang, { n: band.people.length })}</span>
          </button>
        </li>
      ))
    }
    {/* Slides to the selected era in its colour (src/scripts/era-ribbon.ts); last, so `li + li` rules skip it */}
    <li class="ribbon-indicator" aria-hidden="true"></li>
  </ol>
</nav>
