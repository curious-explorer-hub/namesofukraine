---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { eras, isNew, type Person } from '../lib/people';
import { t, type Lang } from '../i18n';

interface Props {
  people: Person[];
  lang: Lang;
}

const { people, lang } = Astro.props;
// A faded picture of each era sits behind its band (credits: src/content/eras.json, About page).
// Shown at about a quarter opacity in grayscale, so a low quality setting is invisible and saves bytes;
// cropped to the band shape (about 180×150 CSS px, at 2× density), centred like the CSS `cover`.
const eraImages = import.meta.glob<{ default: ImageMetadata }>('../assets/eras/*.jpg', { eager: true });
const background = async (file: string) => {
  const img = eraImages[`../assets/eras/${file}`]?.default;
  return img ? `--era-bg: url(${(await getImage({ src: img, width: 360, height: 300, fit: 'cover', format: 'webp', quality: 50 })).src})` : undefined;
};
const bands = await Promise.all(eras.map(async (era) => ({
  ...era,
  bg: await background(era.image.file),
  people: people
    .filter((p) => p.data.era === era.id)
    .sort((a, b) => a.data.born.getTime() - b.data.born.getTime()),
})));
// Bars are scaled to the fullest era, so the busiest band always spans the full width.
const most = Math.max(1, ...bands.map((b) => b.people.length));
---

<nav class="ribbon" aria-labelledby="ribbon-title">
  <h2 id="ribbon-title" class="visually-hidden">{t('home.eras', lang)}</h2>
  <ol class="ribbon-bands">
    {
      bands.map((band, i) => (
        <li>
          <button
            type="button"
            class="era"
            data-era={band.id}
            style={[band.bg, `--share: ${band.people.length / most}`, `--i: ${i}`].filter(Boolean).join('; ')}
            title={band.image.caption[lang]}
            aria-pressed="false"
            disabled={band.people.length === 0}
          >
            {/* How many people this era has: a number plus a bar scaled to the fullest era. */}
            <span class="era-tally" aria-hidden="true">
              {band.people.length === 0 ? (
                <span class="era-empty">{t('home.era_empty', lang)}</span>
              ) : (
                <>
                  <span class="era-count">{band.people.length}</span>
                  {band.people.some((p) => isNew(p)) && (
                    <span class="era-new">{t('home.era_new', lang, { n: band.people.filter((p) => isNew(p)).length })}</span>
                  )}
                </>
              )}
              <span class="era-bar" />
            </span>
            <span class="era-name">{band.label[lang]}</span>
            <span class="era-span">{band.span[lang]}</span>
            <span class="visually-hidden">{t('home.era_count', lang, { n: band.people.length })}</span>
          </button>
        </li>
      ))
    }
  </ol>
</nav>
