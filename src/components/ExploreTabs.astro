---
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
// One way to browse at a time: search and filters, eras, the birthplace map, or fields.
const tabs = [
  { id: 'search', label: t('explore.tab_search', lang), icon: 'M8.5 2.5a6 6 0 1 0 0 12 6 6 0 0 0 0-12zM13 13l5 5' },
  { id: 'eras', label: t('explore.tab_eras', lang), icon: 'M2 15h16M4 15V9M8 15V5M12 15V8M16 15V3' },
  { id: 'map', label: t('explore.tab_map', lang), icon: 'M10 18s6-5.2 6-10a6 6 0 0 0-12 0c0 4.8 6 10 6 10zM10 10.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z' },
  { id: 'groups', label: t('explore.tab_groups', lang), icon: 'M3 3h6v6H3zM11 3h6v6h-6zM3 11h6v6H3zM11 11h6v6h-6z' },
];
---

<!-- Tabs need JavaScript (src/scripts/explore.ts). Without it the tab bar is hidden and every panel is
     shown, one after another (noscript style in BaseLayout). -->
<section class="explore" data-explore aria-label={t('explore.label', lang)}>
  <div class="explore-tabs" role="tablist" aria-label={t('explore.label', lang)}>
    {
      tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          class="explore-tab"
          id={`tab-${tab.id}`}
          data-tab={tab.id}
          aria-controls={`panel-${tab.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? '0' : '-1'}>
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d={tab.icon} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span>{tab.label}</span>
        </button>
      ))
    }
    <span class="explore-indicator" aria-hidden="true"></span>
  </div>
  <div class="explore-panels">
    {
      tabs.map((tab, i) => (
        <div class="explore-panel" role="tabpanel" id={`panel-${tab.id}`} data-panel={tab.id} aria-labelledby={`tab-${tab.id}`} hidden={i !== 0}>
          <slot name={tab.id} />
        </div>
      ))
    }
  </div>
</section>
