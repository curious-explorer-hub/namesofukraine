---
import { Image } from 'astro:assets';
import type { Person } from '../lib/people';

interface Props {
  person: Person;
  sizes: string;
  widths: number[];
  class?: string;
  loading?: 'lazy' | 'eager';
  // 'span' inside buttons and other phrasing-only content (era bands)
  tag?: 'div' | 'span';
  // Width / height of the frame. A photo wider than the frame is cropped to its middle, so the browser
  // needs a proportionally wider file than the frame width to stay sharp.
  ratio?: number;
}

const { person, sizes: frameSizes, widths: frameWidths, class: className, loading = 'lazy', tag: Tag = 'div', ratio } = Astro.props;
const image = person.data.image;
const scale = image && ratio ? Math.max(1, image.src.width / image.src.height / ratio) : 1;
const widths = scale > 1 ? [...new Set(frameWidths.map((w) => Math.min(Math.round(w * scale), image!.src.width)))] : frameWidths;
const sizes = scale > 1 ? frameSizes.replace(/(\S+)(?=\s*(,|$))/g, `calc($1 * ${scale.toFixed(2)})`) : frameSizes;
// Faces sit in the upper part of most portraits.
const position = image?.position ?? '50% 22%';
const words = person.data.name.split(/\s+/);
const initials = [words[0], words.length > 1 ? words.at(-1) : undefined].map((w) => w?.[0] ?? '').join('');
---

{
  image ? (
    <Tag class:list={['portrait', className]}>
      <Image
        src={image.src}
        alt={image.alt}
        widths={widths}
        sizes={sizes}
        loading={loading}
        fetchpriority={loading === 'eager' ? 'high' : undefined}
        style={`object-position: ${position}`}
      />
    </Tag>
  ) : (
    // No freely licensed portrait: the name is already next to it, so the monogram is decorative.
    <Tag class:list={['portrait', 'portrait-monogram', className]} aria-hidden="true">
      <span>{initials}</span>
    </Tag>
  )
}

