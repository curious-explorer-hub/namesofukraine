---
import { localePath } from '../lib/people';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<!-- Needs JavaScript (src/scripts/search.ts); the button is hidden without it (noscript style in BaseLayout). -->
<button type="button" class="search-open" data-search-open aria-haspopup="dialog" aria-keyshortcuts="/ Control+K Meta+K">
  <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="2" /><path d="M13 13l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
  <span class="search-open-label">{t('search.open', lang)}</span>
  <kbd class="search-key" aria-hidden="true">/</kbd>
</button>
<dialog
  class="search"
  data-search
  aria-label={t('search.label', lang)}
  data-src={localePath(lang, '/search.json')}
  data-empty={t('search.empty', lang)}
  data-loading={t('search.loading', lang)}
  data-error={t('search.error', lang)}
  data-found={t('filter.found', lang)}>
  <div class="search-panel">
    <form class="search-form" role="search">
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="2" /><path d="M13 13l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      <input
        class="search-input"
        type="search"
        role="combobox"
        aria-expanded="false"
        aria-controls="search-results"
        aria-autocomplete="list"
        aria-label={t('search.label', lang)}
        placeholder={t('search.placeholder', lang)}
        autocomplete="off"
        enterkeyhint="go"
      />
      <button type="button" class="search-close" aria-label={t('search.close', lang)}><kbd aria-hidden="true">Esc</kbd></button>
    </form>
    <ul id="search-results" class="search-results" role="listbox" aria-label={t('search.label', lang)}></ul>
    <p class="search-status" role="status" aria-live="polite"></p>
  </div>
</dialog>
