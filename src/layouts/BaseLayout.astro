---
import '../styles/global.css';
import { t, languages, type Lang } from '../i18n';
import { localePath } from '../lib/people';
import { jsonForScript } from '../lib/json';
// Same mark as the favicon, inlined so it scales crisply and needs no extra request.
import mark from '../../public/favicon.svg?raw';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  // Path of the share card; defaults to the site card for this language.
  ogImage?: string;
  // Error pages: kept out of search results, with no canonical or language alternates.
  noindex?: boolean;
  // schema.org objects (src/lib/structured-data.ts), emitted as JSON-LD.
  structuredData?: object[];
}

const { lang, title, description = t('site.description', lang), ogImage: ogPath = `/og/${lang}/site.jpg`, noindex = false, structuredData = [] } = Astro.props;
// Share preview: a generated 1200×630 card (src/lib/og.ts).
const ogImage = new URL(ogPath, Astro.site);
const fullTitle = title ? `${title} - ${t('site.title', lang)}` : `${t('site.title', lang)}: ${t('home.title', lang)}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Every page exists in both languages at the same path under /uk/ or /en/.
const basePath = Astro.url.pathname.replace(/^\/(uk|en)(?=\/|$)/, '') || '/';
const pathIn = (l: Lang) => localePath(l, basePath);
const home = localePath(lang, '/');
const langShort: Record<Lang, string> = { uk: 'УКР', en: 'EN' };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          {languages.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathIn(l), Astro.site)} />)}
          <link rel="alternate" hreflang="x-default" href={new URL(pathIn('uk'), Astro.site)} />
        </>
      )
    }
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'uk' ? 'uk_UA' : 'en_GB'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Light or dark theme before the first paint (public/theme.js; no inline scripts under the CSP) -->
    <script is:inline src="/theme.js"></script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={t('site.title', lang)} href={new URL(localePath(lang, '/rss.xml'), Astro.site)} />
    <slot name="head" />
    <!-- The filter bar, the explore tabs and the map's region list need JavaScript. They are visible from
         the first paint (no layout shift when the script starts) and hidden only for visitors without it. -->
    <noscript><style>.theme-toggle, .filters, .map-side, .explore-tabs, .progress-card, .daily-hero { display: none !important; } .explore-panel[hidden] { display: block !important; }</style></noscript>
    {structuredData.map((item) => <script is:inline type="application/ld+json" set:html={jsonForScript(item)} />)}
    <link rel="preload" href="/fonts/FixelDisplay-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/FixelText-Regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header-inner">
        <a class="logo" href={home} aria-label={t('nav.home_label', lang)}>
          <span class="logo-mark" aria-hidden="true" set:html={mark} />
          <span class="logo-text">{t('site.title', lang)}</span>
        </a>
        <nav class="site-nav" aria-label={t('nav.label', lang)}>
          <!-- Two pill switches with a thumb that slides to the active option (styles: global.css, "Header switches") -->
          <button class="switch theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label={t('theme.dark', lang)} title={t('theme.dark', lang)}>
            <span class="switch-thumb" aria-hidden="true"></span>
            <span class="switch-option" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.5" /><path d="M12 1.5v2.5M12 20v2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M1.5 12H4M20 12h2.5M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8" /></svg></span>
            <span class="switch-option" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" /></svg></span>
          </button>
          <!-- Plain links, so it works without JavaScript; the thumb slides across the page change (view transition) -->
          <div class="switch lang-toggle" role="group" aria-label={t('lang.label', lang)} data-active={lang}>
            <span class="switch-thumb" aria-hidden="true"></span>
            {languages.map((l) => (
              <a class="switch-option" href={pathIn(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} aria-label={l === lang ? undefined : t('lang.switch_label', lang)}>{langShort[l]}</a>
            ))}
          </div>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer-inner">
        <p class="site-footer-note">{t('footer.note', lang)}</p>
        <nav aria-label={t('footer.label', lang)}>
          <a href={localePath(lang, '/about/')}>{t('footer.about', lang)}</a>
          <a href={localePath(lang, '/feedback/')}>{t('footer.suggest', lang)}</a>
          <a href={localePath(lang, '/support/')}>{t('footer.support', lang)}</a>
          <a href={localePath(lang, '/new/')}>{t('nav.new', lang)}</a>
          <a href={localePath(lang, '/credits/')}>{t('footer.credits', lang)}</a>
          <a href={localePath(lang, '/rss.xml')}>RSS</a>
        </nav>
      </div>
    </footer>
    <script>
      import { initReadMarks } from '../scripts/read-marks';
      import { initPortraitTransitions, initCardSpotlight } from '../scripts/motion';
      import { initEraIndicator } from '../scripts/era-ribbon';
      import { initThemeToggle } from '../scripts/theme';
      initThemeToggle();
      initReadMarks();
      initEraIndicator();
      initPortraitTransitions();
      initCardSpotlight();
    </script>
  </body>
</html>
