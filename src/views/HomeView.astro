---
import BaseLayout from '../layouts/BaseLayout.astro';
import EraRibbon from '../components/EraRibbon.astro';
import FilterBar from '../components/FilterBar.astro';
import PersonCard from '../components/PersonCard.astro';
import DailyHero from '../components/DailyHero.astro';
import GroupTiles from '../components/GroupTiles.astro';
import CollectionTiles from '../components/CollectionTiles.astro';
import BirthMap from '../components/BirthMap.astro';
import ExploreTabs from '../components/ExploreTabs.astro';
import ReadProgress from '../components/ReadProgress.astro';
import Insight from '../components/Insight.astro';
import { getPeople, recentlyAdded, byBirth, localePath } from '../lib/people';
import { getImage } from 'astro:assets';
import heroImage from '../assets/hero/independence-monument.jpg';
import { t, type Lang } from '../i18n';
import { websiteLd } from '../lib/structured-data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const people = (await getPeople(lang)).sort(byBirth);
const recent = recentlyAdded(people);
// Hero background (credit: src/content/hero.json, shown on the About page). It is the largest
// element on first paint, so it is preloaded; phones show it small and faint, so they get a lighter file.
const heroBg = (await getImage({ src: heroImage, width: 1400, format: 'webp', quality: 60 })).src;
const heroBgSmall = (await getImage({ src: heroImage, width: 700, format: 'webp', quality: 60 })).src;
const phone = '(max-width: 47.99rem)';
---

<BaseLayout
  lang={lang}
  structuredData={[websiteLd(t('site.title', lang), new URL(localePath(lang, '/'), Astro.site), lang, t('site.description', lang))]}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroBgSmall} type="image/webp" media={phone} fetchpriority="high" />
    <link rel="preload" as="image" href={heroBg} type="image/webp" media={`not all and ${phone}`} fetchpriority="high" />
  </Fragment>
  <header class="hero" style={`--hero-bg: url(${heroBg}); --hero-bg-small: url(${heroBgSmall})`}>
    <h1 class="hero-title">{t('home.title', lang)}</h1>
    <p class="hero-lead">{t('home.lead', lang)}</p>
  </header>

  <div class="home-strip">
    <DailyHero lang={lang} />
    <ReadProgress lang={lang} total={people.length} />
    <Insight people={people} lang={lang} />
  </div>
  <ExploreTabs lang={lang}>
    <FilterBar slot="search" people={people} lang={lang} progress={false} />
    <EraRibbon slot="eras" people={people} lang={lang} />
    <BirthMap slot="map" people={people} lang={lang} />
    <GroupTiles slot="groups" people={people} lang={lang} />
    <CollectionTiles slot="collections" people={people} lang={lang} />
  </ExploreTabs>

  {
    recent.length > 0 && (
      <section class="recent" aria-labelledby="recent-title">
        <h2 id="recent-title" class="section-title">{t('home.recent', lang)}</h2>
        <ul class="shelf" role="list">
          {recent.map((p) => (
            <PersonCard person={p} />
          ))}
        </ul>
        <p class="recent-more"><a href={localePath(lang, '/new/')}>{t('home.recent_all', lang)}</a></p>
      </section>
    )
  }


  {/* Search and filter results. Without a narrowing filter the group tiles stand in for these sections.
      The cards, every person once per field, are fetched after load (src/scripts/catalogue.ts). */}
  <div class="catalogue catalogue-results" data-src={localePath(lang, '/home-cards/')}>
    <p class="catalogue-empty" hidden data-all-read={t('filter.all_read', lang)}>
      {t('filter.empty', lang)}
    </p>
  </div>
</BaseLayout>

<script>
  import { initFilters } from '../scripts/filter';
  import { initBirthMap } from '../scripts/birth-map';
  import { initExplore } from '../scripts/explore';
  import { initInsight } from '../scripts/insight';
  import { loadCatalogue } from '../scripts/catalogue';
  import { initDailyHero } from '../scripts/daily-hero';
  initExplore();
  // Filters, the map, the daily hero and the insight card read the people from the cards.
  loadCatalogue().then(() => {
    initDailyHero();
    initFilters();
    initBirthMap();
    initInsight();
  });
</script>
