---
import BaseLayout from '../layouts/BaseLayout.astro';
import PersonCard from '../components/PersonCard.astro';
import { getPeople, additionBatches, isNew, fullDate } from '../lib/people';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
// Approved profiles published in the last 30 days (the cards' «Нове» badge), at most 50; in dev too, since
// drafts are reviewed under /admin/drafts/ and in their collections.
const batches = additionBatches((await getPeople(lang)).filter((p) => p.data.status === 'approved' && isNew(p)), 50);
---

<BaseLayout lang={lang} title={t('new.title', lang)} description={t('new.description', lang)}>
  <header class="page-head">
    <h1 class="page-title">{t('new.title', lang)}</h1>
  </header>

  {batches.length === 0 && <p class="page-lead">{t('new.none', lang)}</p>}
  {
    batches.map((b, bi) => (
      <section class="batch" aria-labelledby={`batch-${b.date.getTime()}`}>
        <h2 id={`batch-${b.date.getTime()}`} class="section-title">
          {t('new.added_on', lang, { date: fullDate(b.date, false, lang) })}{' '}
          <span class="section-count">{b.people.length}</span>
        </h2>
        <ul class="shelf shelf-wrap" role="list">
          {b.people.map((p, i) => (
            <PersonCard person={p} eager={bi === 0 && i === 0} />
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>
