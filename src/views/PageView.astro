---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SOCIAL_LINKS, SUGGEST_FORM_URL, SUPPORT_LINKS } from '../site';
import { suggestEmbedUrl } from '../lib/suggest';
import { localePath } from '../lib/people';
import eras from '../content/eras.json';
import collections from '../content/collections.json';
import hero from '../content/hero.json';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  page: 'about' | 'suggest' | 'credits' | 'support';
}

const { lang, page } = Astro.props;
const entry = await getEntry('pages', `${lang}/${page}`);
if (!entry) throw new Error(`Missing page content: src/content/pages/${lang}/${page}.md`);
const { Content } = await render(entry);

// Only accounts whose URL is set in src/site.ts are shown.
const social = [
  { name: 'Instagram', url: SOCIAL_LINKS.instagram },
  { name: 'Threads', url: SOCIAL_LINKS.threads },
].filter((l) => l.url);
const donate = [
  { name: t('support.monobank', lang), url: SUPPORT_LINKS.monobank },
  { name: 'Patreon', url: SUPPORT_LINKS.patreon },
].filter((l) => l.url);
const joinUrl = localePath(lang, '/feedback/?type=volunteer#form');
---

<BaseLayout lang={lang} title={entry.data.title} description={entry.data.description}>
  <header class="page-head">
    <h1 class="page-title">{entry.data.title}</h1>
    <p class="page-lead">{entry.data.description}</p>
  </header>

  <div class="page-body prose">
    <Content />
  </div>

  {
    page === 'about' && (
      <section class="page-body prose community" aria-labelledby="community">
        <h2 id="community">{t('community.title', lang)}</h2>
        <p>{t('community.lead', lang)}</p>
        <ul class="link-buttons">
          <li><a class="link-button link-button-primary" href={localePath(lang, '/support/')}>{t('community.support_link', lang)}</a></li>
          <li><a class="link-button" href={joinUrl}>{t('community.join_link', lang)}</a></li>
        </ul>
        <h2>{t('community.social_title', lang)}</h2>
        <p>{t('community.social_lead', lang)}</p>
        {social.length ? (
          <ul class="link-buttons">
            {social.map((l) => <li><a class="link-button" href={l.url} rel="me noopener">{l.name}</a></li>)}
          </ul>
        ) : (
          <p class="suggest-pending">{t('community.social_pending', lang)}</p>
        )}
      </section>
    )
  }

  {
    page === 'support' && (
      <section class="page-body prose community">
        <h2>{t('support.donate_title', lang)}</h2>
        {donate.length > 0 && (
          <ul class="link-buttons">
            {donate.map((l) => <li><a class="link-button link-button-primary" href={l.url} rel="noopener">{l.name}</a></li>)}
          </ul>
        )}
        {!SUPPORT_LINKS.monobank && <p class="suggest-pending">{t('support.monobank_pending', lang)}</p>}
        <h2>{t('support.join_title', lang)}</h2>
        <p>{t('support.join_lead', lang)}</p>
        <ul class="link-buttons">
          <li><a class="link-button" href={joinUrl}>{t('community.join_link', lang)}</a></li>
        </ul>
        <h2>{t('community.social_title', lang)}</h2>
        <p>{t('community.social_lead', lang)}</p>
        {social.length ? (
          <ul class="link-buttons">
            {social.map((l) => <li><a class="link-button" href={l.url} rel="me noopener">{l.name}</a></li>)}
          </ul>
        ) : (
          <p class="suggest-pending">{t('community.social_pending', lang)}</p>
        )}
      </section>
    )
  }

  {
    page === 'credits' && (
      <section class="page-body prose credits" aria-labelledby="era-credits">
        <h2 id="era-credits">{t('about.era_credits', lang)}</h2>
        <ul>
          <li>
            {t('about.hero_credit', lang)}: <a href={hero.source_url}>{hero.caption[lang]}</a> - {hero.author}, {hero.license}
          </li>
          {eras.map((e) => (
            <li>
              {e.label[lang]}: <a href={e.image.source_url}>{e.image.caption[lang]}</a> - {e.image.author[lang]}, {e.image.license}
            </li>
          ))}
          {collections.collections.map((c) => (
            <li>
              {c.label[lang]}: <a href={c.image.source_url}>{c.image.caption[lang]}</a> - {c.image.author[lang]}, {c.image.license}
            </li>
          ))}
          <li>
            {t('about.map_credit', lang)}: <a href="https://www.geoboundaries.org/">geoBoundaries</a> (UKR ADM1), © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>, ODbL 1.0
          </li>
          <li>
            {t('about.world_credit', lang)}: <a href="https://www.naturalearthdata.com/">Natural Earth</a> (1:110m land), public domain
          </li>
        </ul>
      </section>
    )
  }

  {
    page === 'suggest' && (
      <section class="suggest-form" id="form" aria-label={t('suggest.form_label', lang)}>
        {SUGGEST_FORM_URL ? (
          <>
            {/* The form (about 1.7 MB from Tally) loads on request, or at once when the reader came to write
                (a "Tell us" link on a profile, ?type=); without JavaScript it is embedded as before. */}
            <button class="suggest-open" type="button" data-suggest-open>{t('suggest.write', lang)}</button>
            <iframe data-suggest-form data-src={suggestEmbedUrl(SUGGEST_FORM_URL, { lang })} data-lang={lang} title={t('suggest.form_label', lang)} hidden />
            <noscript><iframe src={suggestEmbedUrl(SUGGEST_FORM_URL, { lang })} title={t('suggest.form_label', lang)} loading="lazy" /></noscript>
            <p><a href={SUGGEST_FORM_URL}>{t('suggest.open_form', lang)}</a></p>
          </>
        ) : (
          <p class="suggest-pending">{t('suggest.form_pending', lang)}</p>
        )}
      </section>
    )
  }
</BaseLayout>

<script>
  // A "Report a mistake" link on a profile opens /feedback/?type=correction&profile=<slug>: pass that on
  // to the embedded form, so the message arrives tagged with the profile, and open the form at once.
  import { suggestEmbedUrl } from '../lib/suggest';
  const frame = document.querySelector<HTMLIFrameElement>('[data-suggest-form]');
  const open = document.querySelector<HTMLButtonElement>('[data-suggest-open]');
  const params = new URLSearchParams(location.search);
  if (frame && open) {
    const load = () => {
      frame.src = suggestEmbedUrl(frame.dataset.src!, { lang: frame.dataset.lang ?? 'uk', type: params.get('type'), profile: params.get('profile') });
      frame.hidden = false;
      open.remove();
    };
    if (params.has('profile') || params.has('type')) load();
    else open.addEventListener('click', () => { load(); frame.focus(); });
  }
</script>
