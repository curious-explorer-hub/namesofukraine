---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SUGGEST_FORM_URL } from '../site';
import { suggestEmbedUrl } from '../lib/suggest';
import eras from '../content/eras.json';
import hero from '../content/hero.json';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  page: 'about' | 'suggest' | 'credits';
}

const { lang, page } = Astro.props;
const entry = await getEntry('pages', `${lang}/${page}`);
if (!entry) throw new Error(`Missing page content: src/content/pages/${lang}/${page}.md`);
const { Content } = await render(entry);
---

<BaseLayout lang={lang} title={entry.data.title} description={entry.data.description}>
  <header class="page-head">
    <h1 class="page-title">{entry.data.title}</h1>
    <p class="page-lead">{entry.data.description}</p>
  </header>

  <div class="page-body prose">
    <Content />
  </div>

  {
    page === 'credits' && (
      <section class="page-body prose credits" aria-labelledby="era-credits">
        <h2 id="era-credits">{t('about.era_credits', lang)}</h2>
        <ul>
          <li>
            {t('about.hero_credit', lang)}: <a href={hero.source_url}>{hero.caption[lang]}</a> - {hero.author}, {hero.license}
          </li>
          {eras.map((e) => (
            <li>
              {e.label[lang]}: <a href={e.image.source_url}>{e.image.caption[lang]}</a> - {e.image.author[lang]}, {e.image.license}
            </li>
          ))}
          <li>
            {t('about.map_credit', lang)}: <a href="https://www.geoboundaries.org/">geoBoundaries</a> (UKR ADM1), © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>, ODbL 1.0
          </li>
        </ul>
      </section>
    )
  }

  {
    page === 'suggest' && (
      <section class="suggest-form" aria-label={t('suggest.form_label', lang)}>
        {SUGGEST_FORM_URL ? (
          <>
            <iframe src={suggestEmbedUrl(SUGGEST_FORM_URL, { lang })} data-suggest-form data-lang={lang} title={t('suggest.form_label', lang)} loading="lazy" />
            <p><a href={SUGGEST_FORM_URL}>{t('suggest.open_form', lang)}</a></p>
          </>
        ) : (
          <p class="suggest-pending">{t('suggest.form_pending', lang)}</p>
        )}
      </section>
    )
  }
</BaseLayout>

<script>
  // A "Report a mistake" link on a profile opens /feedback/?type=correction&profile=<slug>: pass that on
  // to the embedded form, so the message arrives tagged with the profile.
  import { suggestEmbedUrl } from '../lib/suggest';
  const frame = document.querySelector<HTMLIFrameElement>('[data-suggest-form]');
  const params = new URLSearchParams(location.search);
  if (frame && (params.has('profile') || params.has('type'))) {
    frame.src = suggestEmbedUrl(frame.src, { lang: frame.dataset.lang ?? 'uk', type: params.get('type'), profile: params.get('profile') });
  }
</script>
