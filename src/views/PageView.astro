---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import License from '../components/License.astro';
import { FEEDBACK_SITEKEY, SUPPORT_LINKS } from '../site';
import { FEEDBACK_LIMITS, FEEDBACK_TYPES } from '../lib/feedback';
import { socialLinks, supportLinks } from '../lib/social';
import { collections, localePath } from '../lib/people';
import eras from '../content/eras.json';
import hero from '../content/hero.json';
import tiers from '../content/patrons.json';
import { t, type Key, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  page: 'about' | 'suggest' | 'credits' | 'support' | 'patrons';
}

const { lang, page } = Astro.props;
const entry = await getEntry('pages', `${lang}/${page}`);
if (!entry) throw new Error(`Missing page content: src/content/pages/${lang}/${page}.md`);
const { Content } = await render(entry);

const donate = supportLinks(lang);
const joinUrl = localePath(lang, '/feedback/?type=volunteer#form');
// Patrons: highest tier first. Until the first patron is listed the page has no footer link and stays out of search.
const patronTiers = [...tiers].sort((a, b) => b.price - a.price);
const noPatrons = tiers.every((tier) => tier.patrons.length === 0);
---

<BaseLayout lang={lang} title={entry.data.title} description={entry.data.description} noindex={page === 'patrons' && noPatrons}>
  <header class="page-head">
    <h1 class="page-title">{entry.data.title}</h1>
    <p class="page-lead">{entry.data.description}</p>
  </header>

  <div class="page-body prose">
    <Content />
  </div>

  {
    page === 'about' && (
      <section class="page-body prose community" aria-labelledby="community">
        <h2 id="community">{t('community.title', lang)}</h2>
        <p>{t('community.lead', lang)}</p>
        <ul class="link-buttons">
          <li><a class="link-button" href={localePath(lang, '/support/')}>{t('community.support_link', lang)}</a></li>
          <li><a class="link-button" href={joinUrl}>{t('community.join_link', lang)}</a></li>
        </ul>
        <h2>{t('community.social_title', lang)}</h2>
        <p>{t('community.social_lead', lang)}</p>
        {socialLinks.length ? (
          <ul class="link-buttons">
            {socialLinks.map((l) => <li><a class="link-button link-button-social" href={l.url} target="_blank" rel="me noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={l.icon} /></svg>{l.name}</a></li>)}
          </ul>
        ) : (
          <p class="suggest-pending">{t('community.social_pending', lang)}</p>
        )}
      </section>
    )
  }

  {
    page === 'support' && (
      <section class="page-body prose community">
        <h2>{t('support.donate_title', lang)}</h2>
        {donate.length > 0 && (
          <ul class="link-buttons">
            {donate.map((l) => <li><a class="link-button link-button-social" href={l.url} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={l.icon} /></svg>{l.name}</a></li>)}
          </ul>
        )}
        {!SUPPORT_LINKS.monobank && <p class="suggest-pending">{t('support.monobank_pending', lang)}</p>}
        <h2>{t('support.join_title', lang)}</h2>
        <p>{t('support.join_lead', lang)}</p>
        <ul class="link-buttons">
          <li><a class="link-button" href={joinUrl}>{t('community.join_link', lang)}</a></li>
        </ul>
      </section>
    )
  }

  {
    page === 'credits' && (
      <details class="page-body prose credits">
        <summary><h2>{t('about.era_credits', lang)} <span class="credits-count">({eras.length + collections.length + 3})</span></h2></summary>
        <ul>
          <li>
            {t('about.hero_credit', lang)}: <a href={hero.source_url}>{hero.caption[lang]}</a> - {hero.author}, <License name={hero.license} />
          </li>
          {eras.map((e) => (
            <li>
              {e.label[lang]}: <a href={e.image.source_url}>{e.image.caption[lang]}</a> - {e.image.author[lang]}, <License name={e.image.license} />
            </li>
          ))}
          {collections.map((c) => (
            <li>
              {c.label[lang]}: <a href={c.image.source_url}>{c.image.caption[lang]}</a> - {c.image.author[lang]}, <License name={c.image.license} />
            </li>
          ))}
          <li>
            {t('about.map_credit', lang)}: <a href="https://www.geoboundaries.org/">geoBoundaries</a> (UKR ADM1), © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>, ODbL 1.0
          </li>
          <li>
            {t('about.world_credit', lang)}: <a href="https://www.naturalearthdata.com/">Natural Earth</a> (1:110m land), public domain
          </li>
        </ul>
      </details>
    )
  }

  {
    page === 'patrons' && (
      <div class="page-body prose patrons">
        {patronTiers.map((tier) => (
          <section class="patron-tier" data-tier={tier.id} aria-labelledby={`tier-${tier.id}`}>
            <h2 id={`tier-${tier.id}`}>
              {tier.name[lang]} <span class="patron-price">${tier.price} {t('patrons.per_month', lang)}</span>
            </h2>
            <p class="patron-tier-lead">{tier.description[lang]}</p>
            {tier.patrons.length ? (
              <ul class="patron-names">
                {tier.patrons.map((name) => <li>{name}</li>)}
              </ul>
            ) : (
              <p class="patron-empty">{t('patrons.empty', lang)}</p>
            )}
          </section>
        ))}
        <ul class="link-buttons">
          <li><a class="link-button" href={localePath(lang, '/support/')}>{t('patrons.become', lang)}</a></li>
        </ul>
      </div>
    )
  }

  {
    page === 'suggest' && (
      <section class="suggest-form" id="form" aria-label={t('suggest.form_label', lang)}>
        {FEEDBACK_SITEKEY ? (
          <>
            <form
              class="feedback"
              action="/api/feedback"
              method="post"
              data-feedback
              data-sitekey={FEEDBACK_SITEKEY}
              data-lang={lang}
              data-msg-sending={t('feedback.sending', lang)}
              data-msg-wait={t('feedback.wait', lang)}
              data-msg-error={t('feedback.error', lang)}
            >
              <input type="hidden" name="lang" value={lang} />
              <input type="hidden" name="profile" value="" />
              <fieldset class="feedback-field">
                <legend>{t('feedback.type', lang)}</legend>
                {FEEDBACK_TYPES.map((type) => (
                  <label class="feedback-choice">
                    <input type="radio" name="type" value={type} required />
                    {t(`feedback.type.${type}` as Key, lang)}
                  </label>
                ))}
              </fieldset>
              <label class="feedback-field">
                <span>{t('feedback.about', lang)} <span class="feedback-optional">{t('feedback.optional', lang)}</span></span>
                <input name="about" maxlength={FEEDBACK_LIMITS.about} placeholder={t('feedback.about_placeholder', lang)} />
              </label>
              <label class="feedback-field">
                <span>{t('feedback.message', lang)}</span>
                <textarea name="message" rows="6" required maxlength={FEEDBACK_LIMITS.message} placeholder={t('feedback.message_placeholder', lang)} />
              </label>
              <label class="feedback-field">
                <span>{t('feedback.sources', lang)} <span class="feedback-optional">{t('feedback.optional', lang)}</span></span>
                <textarea name="sources" rows="2" maxlength={FEEDBACK_LIMITS.sources} placeholder="https://…" />
              </label>
              <label class="feedback-field">
                <span>{t('feedback.email', lang)} <span class="feedback-optional">{t('feedback.optional', lang)}</span></span>
                <input name="email" type="email" autocomplete="email" maxlength={FEEDBACK_LIMITS.email} placeholder="name@example.com" />
                <small>{t('feedback.email_note', lang)}</small>
              </label>
              <div class="feedback-check" data-feedback-check />
              <noscript><p class="suggest-pending">{t('feedback.noscript', lang)}</p></noscript>
              <div class="feedback-actions">
                <button class="feedback-send" type="submit">{t('feedback.send', lang)}</button>
                <p class="feedback-status" role="status" data-feedback-status />
              </div>
            </form>
            <div class="feedback-done" data-feedback-done tabindex="-1" hidden>
              <h2>{t('feedback.thanks_title', lang)}</h2>
              <p>{t('feedback.thanks', lang)}</p>
            </div>
          </>
        ) : (
          <p class="suggest-pending">{t('suggest.form_pending', lang)}</p>
        )}
      </section>
    )
  }
</BaseLayout>

<script>
  import { initFeedback } from '../scripts/feedback';
  const form = document.querySelector<HTMLFormElement>('form[data-feedback]');
  if (form) initFeedback(form);
</script>
