---
import BaseLayout from '../layouts/BaseLayout.astro';
import FilterBar from '../components/FilterBar.astro';
import PersonCard from '../components/PersonCard.astro';
import { localePath, type Person } from '../lib/people';
import { breadcrumbLd } from '../lib/structured-data';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  label: string;
  members: Person[];
}

const { lang, label, members } = Astro.props;
---

<BaseLayout
  lang={lang}
  title={label}
  description={t('group.lead', lang, { group: label })}
  structuredData={[
    breadcrumbLd([
      { name: t('site.title', lang), url: new URL(localePath(lang, '/'), Astro.site) },
      { name: label, url: new URL(Astro.url.pathname, Astro.site) },
    ]),
  ]}
>
  <header class="page-head">
    <h1 class="page-title">{label}</h1>
    <p class="page-lead">{t('group.lead', lang, { group: label })}</p>
  </header>

  <FilterBar people={members} lang={lang} hideGroup />

  <div class="catalogue">
    <section class="group" aria-label={label}>
      <ul class="shelf shelf-wrap" role="list">
        {members.map((p) => (
          <PersonCard person={p} headingLevel="h2" />
        ))}
      </ul>
    </section>
    <p class="catalogue-empty" hidden data-all-read={t('filter.all_read', lang)}>{t('filter.empty', lang)}</p>
  </div>
</BaseLayout>

<script>
  import { initFilters } from '../scripts/filter';
  initFilters();
</script>
