{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "/uk/",
        "/en/",
        "/uk/about/",
        "/uk/new/",
        "/uk/people/roksolana/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
