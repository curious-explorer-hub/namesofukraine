# Security headers for Cloudflare Pages (backlog item 11).
# - Scripts: same-origin files only (astro.config.mjs keeps scripts out of the HTML), plus
#   Cloudflare Web Analytics (D11).
# - Styles: 'unsafe-inline' because pages set per-image style attributes (e.g. object-position).
# - Frames: only the suggest-form provider (D17: Tally or Google Forms); nobody may frame this site.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src https://tally.so https://docs.google.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
